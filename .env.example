# Copy to .env (git-ignored) and fill in from Supabase → Project Settings → API.
# The API service has its own env file: see api/.env.example.
# Don't put the service-role key in any service's env — RLS does the enforcing.

SUPABASE_URL=https://<project-ref>.supabase.co
# Safe for the browser: RLS is what protects data. Goes into frontend/js/config.js.
SUPABASE_ANON_KEY=
