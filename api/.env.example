# Copy to api/.env (git-ignored) and fill in from Supabase → Project Settings → API.
# Only the anon key belongs here: the API acts as the calling user (RLS enforces
# access). The service-role key must NOT be set — the server refuses to start with it.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

PORT=3000
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:8000

# Live notifications (Stage 5). Optional: leave REALTIME_URL unset to disable them.
# NOTIFY_SECRET must match realtime/.env (at least 16 chars). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REALTIME_URL=http://localhost:8001
NOTIFY_SECRET=

# File uploads (Stage 6). Optional: leave S3_BUCKET empty to disable uploads. If it is set, the
# other three are required. Setup guide: docs/AWS_S3_SETUP.md (private bucket, least-privilege user).
# These credentials live ONLY here: never in the frontend, realtime/.env, or the repo.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
