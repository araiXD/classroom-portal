# Copy to api/.env (git-ignored) and fill in from Supabase → Project Settings → API.
# Only the anon key belongs here: the API acts as the calling user (RLS enforces
# access). The service-role key must NOT be set — the server refuses to start with it.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

PORT=3000
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGIN=http://localhost:8000
