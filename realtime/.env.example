# Copy to realtime/.env (git-ignored). Run with: .venv/bin/uvicorn main:app --port 8001 --env-file .env
# Only the anon key belongs here: tokens are verified through Supabase Auth. The service
# refuses to start if SUPABASE_SERVICE_ROLE_KEY or SUPABASE_JWT_SECRET is set.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Shared with the Express API (api/.env). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NOTIFY_SECRET=
